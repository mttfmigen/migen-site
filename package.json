{
  "name": "migen-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "types:base": "bunx supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > types/base.ts",
    "verifie": "bunx tsc --noEmit && bun run verifie:contenu && bun run verifie:texte && bun run verifie:interdits && bun run verifie:echafaudage && bun run verifie:formulaire && bun run verifie:gabarits && bun run verifie:entete && bun run verifie:hubs && bun run verifie:pied && bunx eslint . && next build",
    "verifie:contenu": "bun scripts/verifie-contenu.ts",
    "verifie:entete": "bun components/site/verification-entete.tsx",
    "verifie:hubs": "bun components/site/accueil/verification-hubs.tsx",
    "verifie:pied": "bun components/site/verification-pied-de-page.tsx",
    "verifie:gabarits": "bun components/site/verification-gabarits.tsx",
    "verifie:texte": "bun components/site/blocs/verification-texte-riche.tsx",
    "verifie:interdits": "node scripts/verifie-interdits.mjs",
    "verifie:formulaire": "bun scripts/verifie-formulaire.tsx",
    "verifie:base": "node scripts/verifie-base.mjs",
    "verifie:seo": "node scripts/verifie-seo.mjs",
    "verifie:fidelite": "node scripts/verifie-fidelite.mjs",
    "verifie:animations": "node scripts/verifie-animations.mjs",
    "verifie:deploiement": "node scripts/verifie-deploiement.mjs",
    "verifie:mobile": "node scripts/verifie-mobile.mjs",
    "verifie:echafaudage": "node scripts/verifie-echafaudage.mjs",
    "verifie:liens": "node scripts/verifie-liens.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
