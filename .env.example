# Site Migen · variables d'environnement
#
# Copier en .env.local et remplir. Ce fichier d'exemple est versionné,
# .env.local ne l'est jamais.
#
# Règle : tout ce qui commence par NEXT_PUBLIC_ est exposé au navigateur.
# Une clé secrète ne porte JAMAIS ce préfixe.

# ---------------------------------------------------------------- Supabase
# URL et clé anonyme : publiques par conception, bornées par la RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de service : contourne la RLS. Jamais côté client, jamais commitée,
# jamais dans une variable NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- Site
# Sert à construire les URL absolues du sitemap et des balises canoniques.
# Exemple : https://migen.fr
NEXT_PUBLIC_SITE_URL=

# Secret partagé avec Vercel Cron pour autoriser les routes d'ingestion
# et de revalidation. Une chaîne aléatoire longue.
CRON_SECRET=

# ---------------------------------------------------------------- HubSpot
# Portail et formulaire cibles de l'API Forms (le portail est celui de
# CLAUDE.md § 2).
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=
# Jeton privé, uniquement pour l'ingestion des contacts et des deals côté console.
HUBSPOT_PRIVATE_TOKEN=

# ------------------------------------------------- mesure et publicité
# Chargés uniquement après consentement. Une variable absente désactive
# simplement le tag, ce n'est pas une erreur.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
# URL complète du script, et non un identifiant (l'ancien nom
# NEXT_PUBLIC_OPENAI_PIXEL_ID n'est lu par aucun code).
NEXT_PUBLIC_OPENAI_PIXEL_SRC=

# Conteneur Google Tag Manager, format GTM-XXXXXXX. Vide = aucun chargement.
# À poser sur Vercel en Production seulement. Posé, GA4, Ads et LinkedIn passent par lui.
NEXT_PUBLIC_GTM_ID=

# ------------------------------------------------- ingestion console (cron)
# Comptes de service pour l'ingestion quotidienne.
GSC_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=

# ------------------------------------------------------------- Thot SEO
# Analyse et score des textes du pipeline articles.
THOT_API_KEY=

# Ouverture à l'indexation. Vaut « oui » UNIQUEMENT sur le déploiement que
# migen.fr sert réellement. Tant que le site vit sur une adresse vercel.app, il
# porte les mêmes pages que le site en ligne : ouvert, il le concurrencerait sur
# ses propres mots clés. Absente, la variable ferme robots.txt en entier.
SITE_INDEXABLE=

# ---------------------------------------------------------------- TeamTailor
# Les candidatures des 14 pages carriere y sont deposees (/api/candidature).
# Sans ces deux valeurs la route repond 503 et le candidat lit une phrase
# honnete avec l'adresse de secours : elle ne dit JAMAIS « c'est envoye »
# sans que ce le soit.
# L'API TeamTailor ne sait pas creer une offre : elle doit exister deja.
# Candidate dans le compte : « Technicien de maintenance - A qualifier F/H »,
# identifiant 8200692, non listee, qui est un fourre-tout de qualification.
TEAMTAILOR_API_KEY=
TEAMTAILOR_JOB_ID=
